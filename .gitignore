# Dependencies
node_modules/

# Build outputs
player/dist/

# Tizen build artifacts
tizen/temp-wgt/
tizen/*.p12
tizen/*.p12
tizen/*.pem
tizen/unsigned.*
tizen/author-cert.pem
tizen/author-key.pem

# WGT files (use releases/ folder for distribution)
*.wgt
!releases/*.wgt

# Local test builds (never committed)
beta/

# Extra playlists for local builds: their URLs can carry logins
player/playlists.local.json

# Favorites API address for local builds, and the favorites themselves
player/favorites.local.json
favorites/favorites.yml
favorites/data/
favorites/favorites.yml.tmp

# Stable folder (build output)
stable/

# Logs
*.log

# Proxy self-signed certs (auto-generated on first run)
certs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Agent files (personal, not for repo)
.session_log.md

# Playwright MCP scratch files
.playwright-mcp/
