{
  "name": "en-tvplayer",
  "version": "1.0.3",
  "description": "Samsung Tizen TV IPTV Player \u2014 install on any Tizen 5.0+ TV",
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w player",
    "build": "npm run build -w player",
    "build:legacy": "npm run build:legacy -w player",
    "check:tizen4": "node scripts/check-tizen4.mjs",
    "check:tizen24": "node scripts/check-tizen24.mjs",
    "test": "npm run test -w player",
    "lint": "eslint player/src scripts androidtv/install.mjs",
    "format": "prettier --write player/src scripts androidtv/install.mjs",
    "format:check": "prettier --check player/src scripts androidtv/install.mjs",
    "release": "node scripts/release.mjs",
    "tizen": "cd tizen && node package.mjs",
    "tizen:legacy": "cd tizen && node package.mjs --legacy",
    "tizen:install": "python3 tizen/install.py",
    "proxy": "npm start -w proxy",
    "favorites": "node favorites/server.mjs",
    "prepare": "husky",
    "android": "cd androidtv && ./gradlew --quiet assembleDebug && echo && echo APK: androidtv/app/build/outputs/apk/debug/app-debug.apk",
    "android:install": "node androidtv/install.mjs"
  },
  "workspaces": [
    "player",
    "tizen",
    "proxy"
  ],
  "keywords": [
    "tizen",
    "iptv",
    "samsung",
    "tv",
    "player"
  ],
  "author": "Nur-allhi",
  "license": "MIT",
  "lint-staged": {
    "player/src/**/*.js": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "player/src/**/*.css": [
      "prettier --write"
    ],
    "scripts/**/*.mjs": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "androidtv/*.mjs": [
      "eslint --max-warnings=0",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
